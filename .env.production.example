# Backend runtime variables. Store real values in your host's secret manager.
DATABASE_URL=postgresql://user:password@host:5432/marketsim?sslmode=require
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
NEWS_API_KEY=
SEC_USER_AGENT=MarketSimulationPlatform/1.0 your_email@example.com
ARENA_API_KEY=
STARTING_CASH=100000
TRADABLE_TICKERS=NVDA,AMD,AVGO,MSFT,GOOGL,AMZN,TSLA
BENCHMARK_TICKERS=SPY,QQQ
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.4-mini
CLAUDE_EFFORT=medium
OPENAI_REASONING_EFFORT=medium
LLM_MAX_TOKENS=800
PROMPT_TICKER_LIMIT=9
SHORT_SELLING_ENABLED=true
FRONTEND_URL=https://your-frontend-domain.example
PUBLIC_READ_ONLY_MODE=true
PUBLIC_OPS_DETAIL_ENABLED=false
SANDBOX_ENABLED=false
ENGINE_NATIVE_REQUIRED=true
API_SECURITY_HEADERS_ENABLED=true
API_HSTS_ENABLED=true
API_CORS_ALLOW_LOCALHOST=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=240
API_WRITE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
API_MAX_REQUEST_BODY_BYTES=1048576
SITE_ANALYTICS_GEO_LOOKUP_ENABLED=true
SITE_ANALYTICS_GEO_PROVIDER=ipapi
SITE_ANALYTICS_GEO_TIMEOUT_SECONDS=1.5
LLM_DAILY_SPEND_LIMIT_USD=1
LLM_MONTHLY_SPEND_LIMIT_USD=20
LLM_FALLBACK_ESTIMATED_COST_PER_CALL_USD=0.016
EVALUATION_SCHEDULER_ENABLED=true
EVALUATION_SCHEDULER_STARTUP_DELAY_SECS=60
OUTCOME_LABELING_ENABLED=true
OUTCOME_LABELING_INTERVAL_MINS=60
OUTCOME_LABELING_HORIZONS=1h,6h,1d,7d
OUTCOME_LABELING_DECISION_LIMIT=2000
REPLAY_MATRIX_SCHEDULE_ENABLED=false
REPLAY_MATRIX_INTERVAL_HOURS=24
REPLAY_MATRIX_STARTUP_DELAY_SECS=300
REPLAY_MATRIX_FIXTURES=sample_earnings_beat.json
REPLAY_MATRIX_PROVIDER_SETS=claude,openai
REPLAY_MATRIX_BOTS=analyst,bear,macro
REPLAY_MATRIX_EXECUTE_ORDERS=false
REPLAY_MATRIX_MAX_FIXTURES_PER_RUN=1
RAG_REQUIRE_EVIDENCE_FOR_TRADES=true
RAG_EVIDENCE_REQUIRED_BOTS=AnalystBot
RAG_SPECULATIVE_BOTS=DegenBot
RAG_BOOTSTRAP_TICKERS=NVDA,AMD,AVGO,MSFT,GOOGL,AMZN,TSLA
RESEARCH_EXPAND_TRADABLE_UNIVERSE=false
RAG_STARTUP_RESET_ID=
RAG_STARTUP_RESET_TICKERS=

# Optional local/agent tooling.
AGENT_MCP_TOKEN=
AGENT_MCP_HTTP_TOKEN=
AGENT_MCP_APPROVAL_REQUIRED=risk_check_order
AGENT_MCP_ALLOWED_TOOLS=
AGENT_MCP_BLOCKED_TOOLS=
AGENT_MCP_HTTP_APPROVAL_REQUIRED=risk_check_order
AGENT_MCP_HTTP_ALLOWED_TOOLS=
AGENT_MCP_HTTP_BLOCKED_TOOLS=

# Frontend build variable. Vite embeds this at build time.
VITE_API_URL=https://your-api-domain.example
VITE_PLAUSIBLE_DOMAIN=your-frontend-domain.example
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.js
VITE_SITE_ANALYTICS_ENABLED=true
